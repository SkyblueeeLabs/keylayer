{
  "version": 1,
  "description": "平台无关的 UI 设计令牌。Web 侧生成 ui/tokens.css（CSS 自定义属性），SwiftUI 侧生成 src/GeneratedTokens.swift。改配色或尺寸只改这里，再跑 npm run spec。",
  "cssVars": {
    "--ink": "#2c2c2a",
    "--muted": "#5f5e5a",
    "--edge": "#d3d1c7",
    "--line": "#eceae4",
    "--blue-border": "#b5d4f4",
    "--amber-border": "#fac775",
    "--green-border": "#9fe1cb",
    "--purple-border": "#cecbf6",
    "--blue": "#185fa5",
    "--blue-bg": "#e6f1fb",
    "--amber": "#ba7517",
    "--amber-bg": "#faeeda",
    "--green": "#0f6e56",
    "--green-bg": "#e1f5ee",
    "--purple": "#534ab7",
    "--purple-bg": "#eeedfe",
    "--panel-width": "320px",
    "--panel-padding": "16px",
    "--panel-radius": "14px",
    "--gap": "12px",
    "--row-gap": "8px",
    "--cap-gap": "6px",
    "--cap-width": "58px",
    "--cap-key-width": "40px",
    "--cap-height": "26px",
    "--cap-radius": "5px",
    "--dot-size": "8px",
    "--title-size": "15px",
    "--body-size": "13px",
    "--caption-size": "12px",
    "--micro-size": "11px"
  },
  "metrics": {
    "panelWidth": 320,
    "panelPadding": 16,
    "panelRadius": 14,
    "gap": 12,
    "rowGap": 8,
    "capGap": 6,
    "capWidth": 58,
    "capKeyWidth": 40,
    "capHeight": 26,
    "capRadius": 5,
    "dotSize": 8,
    "titleSize": 15,
    "bodySize": 13,
    "captionSize": 12,
    "microSize": 11
  },
  "swiftColors": {
    "ink": "#2c2c2a",
    "muted": "#5f5e5a",
    "edge": "#d3d1c7",
    "statusOK": "#0f6e56",
    "statusWarn": "#ba7517",
    "direction": "#185fa5",
    "directionSoft": "#e6f1fb",
    "action": "#ba7517",
    "actionSoft": "#faeeda",
    "scroll": "#0f6e56",
    "scrollSoft": "#e1f5ee",
    "modifier": "#534ab7",
    "modifierSoft": "#eeedfe"
  },
  "groupColors": {
    "direction": "direction",
    "action": "action",
    "scroll": "scroll",
    "modifier": "modifier"
  }
}
